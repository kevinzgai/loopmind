{
  "name": "loopmind",
  "version": "1.1.0",
  "description": "LoopMind - AI 智能体平台：对话、语音、知识库 RAG，规划中支持 Agent Loop 与任务分解",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "cd backend && pnpm run dev",
    "dev:frontend": "cd frontend && pnpm run dev",
    "start": "pnpm run dev",
    "build": "cd frontend && pnpm run build",
    "install:all": "pnpm install && cd backend && pnpm install && cd ../frontend && pnpm install",
    "clean": "rm -rf backend/node_modules frontend/node_modules node_modules",
    "clean:build": "rm -rf frontend/dist"
  },
  "keywords": [
    "ai",
    "chat",
    "voice",
    "asr",
    "tts",
    "deepseek",
    "qwen",
    "aliyun",
    "vue3",
    "express",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "uuid": "^13.0.0",
    "ws": "^8.19.0"
  }
}
