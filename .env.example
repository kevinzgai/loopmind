# 服务器配置
PORT=3000

# DeepSeek AI 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通义千问 AI 配置
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# 默认 AI 服务（deepseek 或 qwen）
DEFAULT_AI_PROVIDER=deepseek

# 阿里云 TTS 配置
ALI_TTS_ACCESS_KEY_ID=your_access_key_id
ALI_TTS_ACCESS_KEY_SECRET=your_access_key_secret
ALI_TTS_APP_KEY=your_app_key

# Seed-ASR 配置（豆包 ASR 服务）
SEED_ASR_APPID=your_appid
SEED_ASR_API_KEY=your_api_key
SEED_ASR_API_SECRET=your_api_secret
SEED_ASR_API_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
SEED_ASR_RESOURCE_ID=volc.seedasr.auc
