# ============================================
# AI 智能对话语音项目 - 环境变量配置示例
# ============================================
# 复制此文件为 .env 并填入真实的配置值
# 同时也需要复制到 backend/.env

# ============================================
# 服务器配置
# ============================================
PORT=3000

# ============================================
# MongoDB 配置
# ============================================
# 本地 MongoDB
# MONGODB_URI=mongodb://localhost:27017/aichat

# 远程 MongoDB（示例）
MONGODB_URI=mongodb://username:password@host:27017/aichat?authSource=admin
MONGODB_DB_NAME=aichat

# ============================================
# AI 模型配置
# ============================================

# DeepSeek AI 配置（必需）
# 获取地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通义千问 AI 配置（可选）
# 获取地址: https://dashscope.aliyun.com
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# 默认 AI 服务提供商（deepseek 或 qwen）
DEFAULT_AI_PROVIDER=deepseek

# ============================================
# 阿里云语音服务配置
# ============================================
# 获取地址: https://nls-portal.console.aliyun.com

# 阿里云 TTS（文字转语音）配置（必需）
ALI_TTS_ACCESS_KEY_ID=your_access_key_id_here
ALI_TTS_ACCESS_KEY_SECRET=your_access_key_secret_here
ALI_TTS_APP_KEY=your_app_key_here

# ============================================
# 配置说明
# ============================================

# 1. DeepSeek API Key
#    - 注册账号: https://platform.deepseek.com
#    - 创建 API Key
#    - 复制并粘贴到 DEEPSEEK_API_KEY

# 2. 通义千问 API Key（可选）
#    - 访问: https://dashscope.aliyun.com
#    - 开通模型服务
#    - 创建 API Key
#    - 复制并粘贴到 QWEN_API_KEY

# 3. 阿里云语音服务
#    - 访问: https://nls-portal.console.aliyun.com
#    - 开通智能语音交互服务
#    - 创建项目，获取 AppKey
#    - 在 RAM 访问控制中创建 AccessKey
#    - 填入对应的配置项

# ============================================
# 注意事项
# ============================================
# - 请勿将包含真实密钥的 .env 文件提交到版本控制
# - 生产环境请使用环境变量或密钥管理服务
# - 定期更换 API Key 以确保安全
# - 体验版服务有并发和配额限制，请注意使用
