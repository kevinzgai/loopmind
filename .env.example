# 服务器配置
PORT=3000

# AI 服务配置
API_KEY=your_api_key_here
BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# Seed-ASR 配置（豆包 ASR 服务）
# 请前往豆包开发者平台获取以下配置
SEED_ASR_APPID=your_seed_asr_appid_here
SEED_ASR_API_KEY=your_seed_asr_api_key_here
SEED_ASR_API_SECRET=your_seed_asr_api_secret_here
# 默认值：wss://asr.hivoice.cn/ws/v1/asr
SEED_ASR_WS_URL=your_seed_asr_ws_url_here
